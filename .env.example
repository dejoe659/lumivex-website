# Public site settings (leave blank to hide the matching link)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=            # digits only, with country code e.g. 234XXXXXXXXXX
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_INSTAGRAM=

# Contact form (Resend, https://resend.com) - server only, never expose
RESEND_API_KEY=
CONTACT_TO_EMAIL=                # where enquiries are delivered
CONTACT_FROM_EMAIL=              # a sender verified in Resend
